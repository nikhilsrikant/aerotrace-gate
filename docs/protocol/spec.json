{
  "name": "AeroTrace A2A",
  "version": "1.0.0",
  "envelope": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://aerotrace.example/a2a/1.0.0/envelope.json",
    "title": "AeroTrace A2A message envelope v1.0.0",
    "type": "object",
    "required": [
      "id",
      "ts",
      "from",
      "to",
      "subject",
      "type",
      "correlationId",
      "payload",
      "sig"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^msg_[0-9]{6,}$"
      },
      "ts": {
        "type": "integer",
        "description": "Unix epoch milliseconds"
      },
      "from": {
        "enum": [
          "Orchestrator",
          "Requirements",
          "Design",
          "Code",
          "Testing",
          "ConfigMgmt"
        ]
      },
      "to": {
        "enum": [
          "Orchestrator",
          "Requirements",
          "Design",
          "Code",
          "Testing",
          "ConfigMgmt",
          "*"
        ],
        "description": "\"*\" broadcasts to every subscriber except the sender"
      },
      "subject": {
        "type": "string",
        "pattern": "^audit\\.[A-Za-z0-9_-]+\\.(orchestrator|requirements|design|code|testing|configmgmt)\\.(request|status|dependency|blocker|finding|heartbeat|result|error)$",
        "description": "audit.<runId>.<sender>.<type>"
      },
      "type": {
        "enum": [
          "request",
          "status",
          "error",
          "finding",
          "dependency",
          "blocker",
          "heartbeat",
          "result"
        ]
      },
      "correlationId": {
        "type": "string",
        "minLength": 1
      },
      "payload": {
        "type": "object"
      },
      "latencyMs": {
        "type": "number"
      },
      "sig": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "HMAC-SHA256, hex, with the sender's key, over canonical JSON of the envelope minus sig, prevHash, hash, accepted and reason"
      },
      "prevHash": {
        "type": "string"
      },
      "hash": {
        "type": "string",
        "description": "sha256(prevHash + canonical({...envelope, accepted, reason}))"
      },
      "accepted": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "request"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/request.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "status"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/status.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "error"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/error.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "finding"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/finding.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "dependency"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/dependency.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "blocker"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/blocker.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "heartbeat"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/heartbeat.json"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "result"
            }
          }
        },
        "then": {
          "properties": {
            "payload": {
              "$ref": "https://aerotrace.example/a2a/1.0.0/payload/result.json"
            }
          }
        }
      }
    ]
  },
  "payloads": {
    "request": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/request.json",
      "title": "Audit request from the Orchestrator",
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Module ID being audited"
        },
        "dal": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "baseline": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "enum": [
              "L1",
              "L2"
            ]
          }
        },
        "requestedBy": {
          "type": "string"
        }
      }
    },
    "status": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/status.json",
      "title": "Progress or state change",
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "dispute": {
          "type": "string",
          "description": "Finding ID this status disputes"
        }
      }
    },
    "error": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/error.json",
      "title": "Agent error",
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/finding.json",
      "title": "A defect, with the evidence that supports it",
      "type": "object",
      "required": [
        "title",
        "severity",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "L1",
            "L2"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            1,
            2,
            3
          ],
          "description": "1 blocks certification"
        },
        "objective": {
          "type": "string",
          "description": "DO-178C objective, e.g. Table A-7"
        },
        "ref": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths of the evidence records; a finding without a source is rejected"
        }
      }
    },
    "dependency": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/dependency.json",
      "title": "One agent needs another agent's output",
      "type": "object",
      "required": [
        "needs",
        "on"
      ],
      "properties": {
        "needs": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "enum": [
            "Requirements",
            "Design",
            "Code",
            "Testing",
            "ConfigMgmt"
          ]
        }
      }
    },
    "blocker": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/blocker.json",
      "title": "A finding that blocks another agent's objectives",
      "type": "object",
      "required": [
        "ref",
        "impact"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "heartbeat": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/heartbeat.json",
      "title": "Liveness",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "$id": "https://aerotrace.example/a2a/1.0.0/payload/result.json",
      "title": "Work finished",
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "number",
          "minimum": 0
        },
        "l1": {
          "type": "number"
        },
        "l2": {
          "type": "number"
        },
        "verdict": {
          "enum": [
            "YES",
            "NO",
            "CONDITIONAL"
          ]
        }
      }
    }
  },
  "senders": {
    "Orchestrator": [
      "request",
      "status",
      "result",
      "error"
    ],
    "Requirements": [
      "status",
      "dependency",
      "blocker",
      "finding",
      "heartbeat",
      "result",
      "error"
    ],
    "Design": [
      "status",
      "dependency",
      "blocker",
      "finding",
      "heartbeat",
      "result",
      "error"
    ],
    "Code": [
      "status",
      "dependency",
      "blocker",
      "finding",
      "heartbeat",
      "result",
      "error"
    ],
    "Testing": [
      "status",
      "dependency",
      "blocker",
      "finding",
      "heartbeat",
      "result",
      "error"
    ],
    "ConfigMgmt": [
      "status",
      "dependency",
      "blocker",
      "finding",
      "heartbeat",
      "result",
      "error"
    ]
  },
  "routing": "Subject audit.<runId>.<sender>.<type>. \"to\" names one receiver, or \"*\" for every subscriber except the sender. Only accepted messages are delivered.",
  "signing": "Each agent has its own key. sig = HMAC-SHA256(key, canonical(envelope without sig/prevHash/hash/accepted/reason)). The broker recomputes it with the key registered for \"from\"; a mismatch is rejected.",
  "chain": "Every message, accepted or rejected, is appended under a lock: hash = sha256(prevHash + canonical({...envelope, sig, accepted, reason})), starting from \"GENESIS\".",
  "rejection": "Rejected messages stay in the trail with accepted=false and a reason, so auditors see what was refused.",
  "versioning": "Semantic versioning. Adding an optional payload field is a minor change; adding a required field, a message type rule or changing signing is a major change and needs a new broker release.",
  "canonicalJson": "Object keys sorted, no whitespace, undefined fields dropped."
}
