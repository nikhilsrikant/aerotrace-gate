{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerotrace.example/a2a/1.0.0/payload/dependency.json",
  "title": "One agent needs another agent's output",
  "type": "object",
  "required": [
    "needs",
    "on"
  ],
  "properties": {
    "needs": {
      "type": "string",
      "minLength": 1
    },
    "on": {
      "enum": [
        "Requirements",
        "Design",
        "Code",
        "Testing",
        "ConfigMgmt"
      ]
    }
  }
}
