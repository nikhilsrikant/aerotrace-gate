{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerotrace.example/a2a/1.0.0/payload/blocker.json",
  "title": "A finding that blocks another agent's objectives",
  "type": "object",
  "required": [
    "ref",
    "impact"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
