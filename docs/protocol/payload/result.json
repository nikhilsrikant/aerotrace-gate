{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerotrace.example/a2a/1.0.0/payload/result.json",
  "title": "Work finished",
  "type": "object",
  "required": [
    "count"
  ],
  "properties": {
    "count": {
      "type": "number",
      "minimum": 0
    },
    "l1": {
      "type": "number"
    },
    "l2": {
      "type": "number"
    },
    "verdict": {
      "enum": [
        "YES",
        "NO",
        "CONDITIONAL"
      ]
    }
  }
}
