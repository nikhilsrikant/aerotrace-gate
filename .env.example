# ---- required ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-64-random-characters
PUBLIC_URL=https://aerotrace.example.com
# Passkeys are bound to this domain. Pick the final hostname before people enrol: moving to a new domain means re-enrolling.
# RP_ID=aerotrace.example.com          # defaults to PUBLIC_URL's host; may be a parent domain such as example.com
# RP_ORIGINS=https://aerotrace.example.com   # every exact URL people open the app on, comma-separated
# First administrator, created by `migrate` on an empty database. Must change the password at first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Gate Administrator
ADMIN_PASSWORD=Change-me-on-first-login-1

# ---- single sign-on (any OpenID Connect provider: Microsoft Entra ID, Okta, Ping, Keycloak) ----
# Redirect URI to register with the provider: ${PUBLIC_URL}/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with Honeywell SSO
OIDC_GROUPS_CLAIM=groups
# DISABLE_LOCAL_LOGIN=true   # once SSO works

# ---- decision signing ----
# Ed25519 private key (PEM, \n for newlines). Leave empty to generate one on first start and keep it in the database.
SIGNING_PRIVATE_KEY=

# ---- Layer 2 reader (optional) ----
LLM_PROVIDER=none            # none | anthropic | openai (any OpenAI-compatible endpoint, e.g. vLLM on-prem)
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---- audit assistant voice input (optional) ----
# Without this, the browser's own speech recognition is used where available.
# Point it at any OpenAI-compatible transcription server (for example faster-whisper on-prem); audio is sent to /audio/transcriptions.
# STT_URL=http://whisper.internal:8000/v1
# STT_MODEL=whisper-1
# STT_API_KEY=

# ---- operations ----
SEED_DEMO_DATA=true          # load the 50,000-record synthetic program on first run
LOG_LEVEL=info
WORKER_CONCURRENCY=2
SCHEDULER_INTERVAL_MS=30000
MAX_UPLOAD_MB=200
METRICS_TOKEN=
SESSION_HOURS=12
