{
  "name": "aerotrace-audit-gate",
  "version": "3.0.0",
  "private": true,
  "description": "Dual-layer DO-178C audit agents with an A2A broker and a one-click human approval gate.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-server.mjs",
    "start": "node .next/standalone/server.js",
    "worker": "node dist/cli.mjs worker",
    "migrate": "node dist/cli.mjs migrate",
    "test": "tsx tests/audit.test.ts && tsx tests/llm-path.test.ts && tsx tests/services.test.ts && tsx tests/bundle.test.ts && tsx tests/assistant.test.ts && tsx tests/passkey.test.ts && tsx tests/program.test.ts && tsx tests/invite.test.ts && tsx tests/protocol.test.ts && tsx tests/cloud.test.ts && tsx tests/workspace.test.ts && tsx tests/connectors.test.ts",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://aerotrace@127.0.0.1:5433/aerotrace_test} sh -c 'tsx tests/services.test.ts && tsx tests/workspace.test.ts'",
    "test:e2e": "bash tests/e2e.sh",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/build-demo.mjs",
    "protocol": "tsx scripts/export-protocol.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "@azure/identity": "^4.13.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.9.1",
    "next": "16.3.8",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  }
}
